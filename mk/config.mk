# Hardware features remain opt-in. These names are part of the build interface.
V3D ?= 0
WIFI ?= 0
STORAGE_VALIDATION ?= 0
SD_BASE_CLOCK_HZ ?= 0
STORAGE_PARTITION ?= 0

ifneq ($(filter-out 0 1,$(V3D) $(WIFI) $(STORAGE_VALIDATION)),)
$(error V3D, WIFI and STORAGE_VALIDATION must be 0 or 1)
endif
ifeq ($(STORAGE_VALIDATION),1)
ifeq ($(SD_BASE_CLOCK_HZ),0)
$(error STORAGE_VALIDATION=1 requires the confirmed SD_BASE_CLOCK_HZ)
endif
endif
ifeq ($(WIFI),1)
ifeq ($(WIFI_FIRMWARE_C),)
$(error WIFI=1 requires WIFI_FIRMWARE_C generated by tools/embed_wifi.py)
endif
endif

CPPFLAGS += -Iinclude -DVANTAGE_V3D=$(V3D) -DVANTAGE_WIFI=$(WIFI)
CPPFLAGS += -DVANTAGE_STORAGE_VALIDATION=$(STORAGE_VALIDATION)
CPPFLAGS += -DSD_BASE_CLOCK_HZ=$(SD_BASE_CLOCK_HZ) -DSTORAGE_PARTITION=$(STORAGE_PARTITION)
