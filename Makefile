CC = aarch64-linux-gnu-gcc
LD = aarch64-linux-gnu-ld
OBJCOPY = aarch64-linux-gnu-objcopy

BUILD_DIR = out
.DEFAULT_GOAL := all
PYTHON ?= python
V3D ?= 0
WIFI ?= 0
STORAGE_VALIDATION ?= 0
SD_BASE_CLOCK_HZ ?= 0
STORAGE_PARTITION ?= 0
ifneq ($(filter-out 0 1,$(V3D) $(WIFI) $(STORAGE_VALIDATION)),)
$(error V3D, WIFI and STORAGE_VALIDATION must be 0 or 1)
endif
ifeq ($(STORAGE_VALIDATION),1)
ifeq ($(SD_BASE_CLOCK_HZ),0)
$(error STORAGE_VALIDATION=1 requires the confirmed SD_BASE_CLOCK_HZ)
endif
endif
ifeq ($(WIFI),1)
ifeq ($(WIFI_FIRMWARE_C),)
$(error WIFI=1 requires WIFI_FIRMWARE_C generated by tools/embed_wifi.py)
endif
endif

C_SOURCES = $(wildcard init/*.c) \
            $(wildcard kernel/*.c) \
            $(wildcard kernel/sched/*.c) \
            kernel/fs/files.c kernel/fs/file_syscall.c kernel/fs/storage.c kernel/fs/storage_pi4.c \
            $(wildcard kernel/sched/delays/*.c) \
            $(wildcard arch/armv8/*.c) \
            $(wildcard mm/*.c) \
            $(wildcard drivers/*/*.c) \
			$(wildcard drivers/*.c) \
            $(wildcard user/lib/*.c) \
            $(wildcard user/env/*.c) \
			$(wildcard kernel/sched/*.c) \
			$(wildcard kernel/sched/delays/*.c) \
			$(wildcard kernel/fs/*.c)

C_SOURCES := $(sort $(C_SOURCES))
S_SOURCES = $(wildcard arch/armv8/*.s)

OBJECTS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(C_SOURCES))
OBJECTS += $(patsubst %.s, $(BUILD_DIR)/%.o, $(S_SOURCES))
MM_OBJECTS = $(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard mm/*.c))

CFLAGS = -Wall -O2 -ffreestanding -nostdinc -Iinclude -Iuser/include
# Firmware discovery runs with the MMU off: unaligned Device accesses can fault.
CFLAGS += -mstrict-align -MMD -MP
CFLAGS += -Iincludes -DVANTAGE_V3D=$(V3D) -DVANTAGE_WIFI=$(WIFI)
CFLAGS += -DVANTAGE_STORAGE_VALIDATION=$(STORAGE_VALIDATION) -DSD_BASE_CLOCK_HZ=$(SD_BASE_CLOCK_HZ) -DSTORAGE_PARTITION=$(STORAGE_PARTITION)
BUILD_CONFIG_FLAGS := $(CFLAGS)
$(MM_OBJECTS): CFLAGS += -Wextra -Werror
$(BUILD_DIR)/kernel/memory.o: CFLAGS += -fno-tree-loop-distribute-patterns
$(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard kernel/sched/*.c) arch/armv8/task_port.c): CFLAGS += -Wextra -Werror
$(BUILD_DIR)/arch/armv8/task_port.o: CFLAGS += -mno-outline-atomics
$(patsubst %.c, $(BUILD_DIR)/%.o, kernel/fs/files.c kernel/fs/file_syscall.c kernel/fs/storage.c kernel/fs/storage_pi4.c drivers/sd.c drivers/sd_pi4.c): CFLAGS += -Wextra -Werror
$(patsubst %.c, $(BUILD_DIR)/%.o, $(wildcard drivers/hw/*.c) $(wildcard drivers/wifi/*.c) drivers/video/v3d.c): CFLAGS += -Wextra -Werror

all: $(BUILD_DIR)/prod/kernel8.img

.PHONY: all clean FORCE
FORCE:

$(BUILD_DIR)/build-config: FORCE tools/build_config.py
	@$(PYTHON) tools/build_config.py --output "$@" --cc="$(CC)" --ld="$(LD)" --objcopy="$(OBJCOPY)" --cflags="$(BUILD_CONFIG_FLAGS)" --firmware="$(WIFI_FIRMWARE_C)"

ifeq ($(WIFI),1)
OBJECTS += $(BUILD_DIR)/drivers/wifi/assets.o
$(BUILD_DIR)/drivers/wifi/assets.o: $(WIFI_FIRMWARE_C)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
endif

$(OBJECTS): $(BUILD_DIR)/build-config Makefile

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/prod/kernel8.img: $(OBJECTS) arch/armv8/linker.ld
	$(LD) -T arch/armv8/linker.ld $(OBJECTS) -o $(BUILD_DIR)/kernel8.elf
	@mkdir -p $(dir $@)
	$(OBJCOPY) -O binary $(BUILD_DIR)/kernel8.elf $@

clean:
	rm -rf $(BUILD_DIR)

-include $(OBJECTS:.o=.d)
